---
layout: layout.njk
pagination:
  data: data.guidanceRequests
  size: 1
  alias: item
permalink: "{{ item.permalink }}"
eleventyComputed:
  title: "{{ item._pageTitle }}"
---

<article class="section-card">
  <header class="section-header">
    <h1>{{ item.title or 'Pending Guidance' }}</h1>
  </header>

  {{ item.bodyHtml | safe }}

  {% if item.relatedFaqs and item.relatedFaqs.length > 0 %}
  <h2>Related FAQs</h2>
  <ul>
    {% for faq in item.relatedFaqs %}
    <li><a href="{{ faq.permalink }}">{{ faq.questionHtml | safe }}</a></li>
    {% endfor %}
  </ul>

  {% endif %}
  {% include "components/common/actions.njk" %}
</article>
